+// A window that has never been floated has no usable remembered floating size
+// (it is only the client's initial size). Floating it at its tiled size, often
+// most of the screen, is never wanted, so start from a modest default instead:
+// 65% of the work area's height at 16:10, at most half its width, and never
+// larger than the window already is.
+static Vector2D defaultFloatingSize(const CBox& workArea, const Vector2D& currentSize) {
+    const double H = workArea.height * 0.65;
+    const double W = std::min(H * 1.6, workArea.width * 0.5);
+    return Vector2D{std::min(W, currentSize.x), std::min(H, currentSize.y)}.floor();
+}
